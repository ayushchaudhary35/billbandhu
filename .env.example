# BillBandhu Environment Configuration
# API keys must be loaded strictly from environment variables. NEVER commit real secrets!

# Primary Model / Provider A
PROVIDER_A=google
MODEL_A=gemini-3.8-flash
API_KEY_A=your_api_key_a_here

# Secondary Model / Provider B (for cross-model consensus)
PROVIDER_B=google
MODEL_B=gemini-3.8-flash
API_KEY_B=your_api_key_b_here

# Fallback Model
MODEL_FALLBACK=gemini-3.8-flash

# Application Settings
APP_ENV=development
PORT=8000
HOST=127.0.0.1
OPT_IN_IMAGE_RETENTION_DEFAULT=false

